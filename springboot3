    out_plain "  ${APP_NAME} install --springboot2 --no-run"
    out_plain "  ${APP_NAME} --prefix shop --port 8088 --no-run"
    out_plain "  ${APP_NAME} --project-base /srv/apps --prefix api --port 9090 --springboot2 --no-run"
    out_plain "  ${APP_NAME} install --no-run            # payload setup for CI"
    out_plain "  ${APP_NAME} self-update                 # upgrade CLI only"
