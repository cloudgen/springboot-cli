app_cmd_menu() {
    local _choice _c3 _c5 _c8 _back _exit _exw _rc
    if [ "${TTY:-0}" -ne 1 ]; then
        out_die "${APP_NAME} menu requires a terminal. Next: ${APP_NAME} help"
    fi
    if [ "${QUIET:-0}" -eq 1 ] && [ "${JSON:-0}" -ne 1 ]; then
        out_die "${APP_NAME} menu cannot run with --quiet. Next: ${APP_NAME} help"
    fi
    while true; do
        _c3=$(app_menu_text cat3)
        _c5=$(app_menu_text cat5)
        _c8=$(app_menu_text cat8)
        _exit=$(app_menu_text exit)
        _exw="${_exit#9. }"
        _menu_header
        out_menu_choice 1 "Spring Boot 3.3.5" "$(app_menu_text L1)"
        out_menu_choice 2 "Spring Boot 2.7.18" "$(app_menu_text L2)"
        out_menu_choice 3 "${_c3}" "$(app_menu_text L3)"
        out_menu_choice 5 "${_c5}" "$(app_menu_text L5)"
        out_menu_choice 8 "${_c8}" "$(app_menu_text L8)"
        _menu_plain "${_exit}"
        _menu_prompt
        if ! read -r _choice; then
            return 0
        fi
        _choice=$(_menu_trim "${_choice}")
        case "${_choice}" in
            ""|9|exit|quit|"${_exw}")
                return 0
                ;;
            1|"Spring Boot 3.3.5")
                _menu_run_line 3 0
                ;;
            2|"Spring Boot 2.7.18")
                _menu_run_line 2 0
                ;;
            3|"${_c3}")
                app_cmd_menu_setup
                ;;
            5|"${_c5}"|language|語言|语言|idioma|langue|Sprache|sprache|言語|언어|لغة|язык|taal|γλώσσα)
                app_cmd_menu_language
                ;;
            8|"${_c8}")
                app_cmd_menu_self
                _rc=$?
                if [ "${_rc}" -eq 2 ]; then
                    return 0
                fi
                ;;
            *)
                _menu_bad "${_choice}"
                ;;
        esac
    done
}

# =============================================================================
# ship_combined_ensure() - Place or refresh the CLI before a non-interactive payload
# =============================================================================
ship_combined_ensure() {
    if ! inst_is_installed; then
        if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ]; then
            if ! inst_perform_install; then
                exit 1
            fi
        else
            if ! inst_maybe_install; then
                exit 1
            fi
        fi
    else
        if [ "${TTY:-0}" -ne 1 ] || [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ]; then
            inst_self_update || true
        fi
    fi
}

app_main() {
    # Safe defaults (repeated on purpose - defensive style)
    : "${HOME:=/root}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${PROJECT_DIR:=${HOME}/springboot-${APP_NAME}}"
    : "${NO_RUN:=0}"
    : "${RESET_PROJECT:=0}"

    # <<< IMPORTANT: Source user shell configuration >>>
    # This must happen early so that PATH, SDKMAN, and user environment
    # are available for ALL sub-commands (about, run, version-check, etc.)
    util_source_user_shell_config

    # Cache folder and persistence (requirement-shell-cli-storage.md).
    # STORAGE_DIR is this host's 1st fallback. It is not an environment override.
    : "${USERNAME:=unknown}"
    EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    STORAGE_DIR=$(util_fallback_cache_dir)
    PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
    export EFFECTIVE_STORAGE_DIR STORAGE_DIR PERSISTENT_STORAGE_DIR
    export TMPDIR="${EFFECTIVE_STORAGE_DIR}"

    # Language leaf is inside persistence. Load once, before the dual-mode split.
    app_lang_load

    local cmd="run"
    local empty_argv=0
    local domain_payload_flag=0
    local positional=0
    if [ $# -eq 0 ]; then
        empty_argv=1
    fi

    # === FLAG-FIRST ARGUMENT PARSING ===
    while [ $# -gt 0 ]; do
        case "$1" in
            --project-dir)
                if [ -z "${2:-}" ]; then
                    out_die "--project-dir requires a path"
                fi
                PROJECT_DIR="$2"
                PROJECT_DIR_EXPLICIT=1
                domain_payload_flag=1
                shift
                ;;
            --project-base|--base-path)
                if [ -z "${2:-}" ]; then
                    out_die "--project-base requires a directory path. Next: ${APP_NAME} help"
                fi
                case "$2" in
                    *$'\n'*|*$'\r'*)
                        out_die "--project-base rejects a path that contains a newline. Next: ${APP_NAME} help"
                        ;;
                esac
                PROJECT_BASE="$2"
                domain_payload_flag=1
                shift
                ;;
            --prefix)
                if [ -z "${2:-}" ]; then
                    out_die "--prefix requires a name. Next: ${APP_NAME} help"
                fi
                domain_require_prefix "$2"
                domain_payload_flag=1
                shift
                ;;
            --port)
                if [ -z "${2:-}" ]; then
                    out_die "--port requires a TCP port from 1 to 65535. Next: ${APP_NAME} help"
                fi
                domain_require_listen_port "$2"
                domain_payload_flag=1
                shift
                ;;
            --no-run)
                NO_RUN=1
                domain_payload_flag=1
                ;;
            --quiet|-q)     QUIET=1 ;;
            --json)         JSON=1; QUIET=1 ;;
            --debug)        DEBUG=1 ;;
            --force)        FORCE=1; FORCE_REINSTALL=1; domain_payload_flag=1 ;;
            --force-user)   FORCE_USER=1; domain_payload_flag=1 ;;
            --force-root)   FORCE_ROOT=1; FORCE_GLOBAL=1; domain_payload_flag=1 ;;
            --reset)        FORCE_REINSTALL=1; RESET_PROJECT=1; domain_payload_flag=1 ;;
            --springboot2)
                BOOT_LINE="springboot2"
                BOOT_LINE_SET=1
                ;;
            --springboot3)
                BOOT_LINE="springboot3"
                BOOT_LINE_SET=1
                ;;
            --boot)
                if [ -z "${2:-}" ]; then
                    out_die "--boot requires a line: 2, 3, springboot2, or springboot3. Next: ${APP_NAME} help"
                fi
                BOOT_LINE="$2"
                BOOT_LINE_SET=1
                shift
                ;;
            --help|-h)      cmd="help";;
            --*|-* )
                out_die "Unknown option: $1. Next: ${APP_NAME} help"
                ;;
            *)              cmd="$1"; positional=1 ;;
        esac
        shift
    done

    # Pin the selected line before help, about, install, menu, or run.
    domain_apply_boot_line "${BOOT_LINE:-3}"

    # Named menu. Off a TTY, or with --quiet and not --json, this dies inside.
    if [ "${cmd}" = "menu" ] || [ "${cmd}" = "main" ]; then
        app_cmd_menu
        exit $?
    fi

    # Interactive TTY, no verb, no line switch, no domain payload flag: numbered menu.
    # --debug is allowed. --json and --quiet stay on the payload path.
    if [ "${positional}" -eq 0 ] \
        && [ "${cmd}" = "run" ] \
        && [ "${BOOT_LINE_SET:-0}" -eq 0 ] \
        && [ "${domain_payload_flag}" -eq 0 ] \
        && [ "${TTY:-0}" -eq 1 ] \
        && [ "${JSON:-0}" -eq 0 ] \
        && [ "${QUIET:-0}" -eq 0 ]; then
        app_cmd_menu
        exit $?
    fi

    # Non-interactive, no positional verb, no domain payload flag:
    # Type O-P combined ensure (ship unit if needed, then the payload).
    # An explicit `run` verb is not this path.
    if [ "${positional}" -eq 0 ] && [ "${cmd}" = "run" ] && [ "${domain_payload_flag}" -eq 0 ]; then
        if [ "${empty_argv}" -eq 1 ] || [ "${BOOT_LINE_SET:-0}" -eq 0 ]; then
            ship_combined_ensure
        fi
    fi

    # Line switch with no positional command: place the CLI when missing,
    # then continue into that line's payload.
    if [ "${empty_argv}" -eq 0 ] && [ "${BOOT_LINE_SET:-0}" -eq 1 ] && [ "${cmd}" = "run" ]; then
        if ! inst_is_installed; then
            if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ]; then
                if ! inst_perform_install; then
                    exit 1
                fi
            else
                if ! inst_maybe_install; then
                    exit 1
                fi
            fi
        fi
    fi

    # === Command Dispatch ===
    case "${cmd}" in
        version)
            if [ "${JSON}" -eq 1 ]; then
                out_json "version" "" "app" "${APP_NAME}" "version" "${VERSION}"
            else
                out_plain "${APP_NAME} version ${VERSION}"
            fi
            exit 0
            ;;

        version-check)
            ver_check
            exit $?
            ;;

        self-update|self-upgrade)
            inst_self_update
            exit $?
            ;;

        self-uninstall)
            inst_self_uninstall
            exit $?
            ;;

        install)
            payload_install
            exit $?
            ;;

        uninstall)
            payload_uninstall
            exit $?
            ;;

        about|status)
            app_about
            exit $?
            ;;

        help)
            app_help
            exit 0
            ;;

        menu|main)
            app_cmd_menu
            exit $?
            ;;

        reinstall)
            FORCE_REINSTALL=1
            FORCE=1
            inst_perform_install || exit $?
            ;;

        run)
            ;;
        *)
            out_die "Invalid command: ${cmd}. Try: ${APP_NAME} help"
            ;;
    esac

    payload_ensure_and_run
    exit $?
}

# =============================================================================
# BOOTSTRAP
# =============================================================================
#
# Always invoke the single dispatcher. Do NOT gate on ${0##*/} matching APP_NAME:
# under curl | sh / stdin pipe, $0 is the shell (sh/bash/…), not the product
# filename — a basename gate causes silent no-op and breaks one-liner install.
# See docs/terminologies/shell-cli-bootstrap.md and INC-20260712-001.
#
# Single-file install CLI: source-as-library is unsupported; main always runs.
# =============================================================================
app_main "$@"

