setup_sdkman() {
    : "${HOME:=/root}"
    : "${JSON:=0}"
    check_alpine_requirements

    # If SDKMAN dir exists, always init safely (set +u) before trusting `sdk` on PATH
    local init="${HOME}/.sdkman/bin/sdkman-init.sh"
    if [ -s "${init}" ]; then
        util_source_external_safe "${init}" 2>/dev/null || true
    fi

    if [ -d "${HOME}/.sdkman" ] && command -v sdk >/dev/null 2>&1; then
        out_info "SDKMAN already installed."
        return 0
    fi

    out_info "Installing SDKMAN..."
    # Installer itself is third-party; run with nounset off so its scripts do not
    # abort our process under set -u (silent or cryptic failures).
    set +u
    curl -fsSL "https://get.sdkman.io" | bash
    local _sdk_install_rc=$?
    set -u
    if [ "${_sdk_install_rc}" -ne 0 ]; then
        out_die "SDKMAN install failed (curl|bash exit ${_sdk_install_rc})"
    fi

    if [ -s "${init}" ]; then
        if ! util_source_external_safe "${init}" 2>/dev/null; then
            out_warn "SDKMAN init script returned non-zero; continuing to locate sdk..."
        fi
    fi

    if ! command -v sdk >/dev/null 2>&1; then
        # Common after fresh install: sdk only on PATH after init in a new shell
        if [ -x "${HOME}/.sdkman/bin/sdk" ]; then
            # shellcheck disable=SC1090
            set +u
            # Prefer exporting candidates dir for direct binary use
            export SDKMAN_DIR="${HOME}/.sdkman"
            PATH="${HOME}/.sdkman/bin:${HOME}/.sdkman/candidates/java/current/bin:${HOME}/.sdkman/candidates/maven/current/bin:${PATH}"
            export PATH
            set -u
        fi
    fi

    if ! command -v sdk >/dev/null 2>&1; then
        out_error "SDKMAN installed but 'sdk' command is not available in this shell."
        out_plain ""
        out_plain "Please run one of these commands, then retry:"
        out_plain "    . \"${HOME}/.sdkman/bin/sdkman-init.sh\""
        out_plain "    or simply open a new terminal"
        out_plain ""
        out_die "SDKMAN not on PATH after install (payload incomplete)"
    fi

    out_info "SDKMAN is ready."
}

# =============================================================================
# domain_require_listen_port() — accept one TCP port and mark it explicit
# =============================================================================
#
# GENERAL PURPOSE:
# Reject anything that is not an integer from 1 to 65535. The accepted value
# is the listen port for this invocation and wins over the line default.
#
# requirement-domain-springboot3.md
# =============================================================================
domain_require_listen_port() {
    local raw="${1-}"
    local n
    case "${raw}" in
        ''|*[!0-9]*)
            out_die "Port '${raw}' is not a TCP port from 1 to 65535. Next: ${APP_NAME} --port <1-65535>"
            ;;
    esac
    n=$((10#${raw}))
    if [ "${n}" -lt 1 ] || [ "${n}" -gt 65535 ]; then
        out_die "Port '${raw}' is not a TCP port from 1 to 65535. Next: ${APP_NAME} --port <1-65535>"
    fi
    PORT="${n}"
    PORT_EXPLICIT=1
}

# =============================================================================
# domain_require_prefix() — accept an instance name for a second project root
# =============================================================================
#
# GENERAL PURPOSE:
# A prefix is a single path segment so two demos can sit beside each other.
# It is not a directory path and it is not a URL context path.
#
# requirement-domain-springboot3.md
# =============================================================================
domain_require_prefix() {
    local raw="${1-}"
    if [ -z "${raw}" ]; then
        out_die "--prefix requires a name of letters, digits, dot, underscore, or hyphen. Next: ${APP_NAME} help"
    fi
    if [ "${#raw}" -gt 64 ]; then
        out_die "--prefix is longer than 64 characters. Next: ${APP_NAME} help"
    fi
    case "${raw}" in
        [A-Za-z0-9]*) ;;
        *)
            out_die "--prefix must start with a letter or digit. Next: ${APP_NAME} help"
            ;;
    esac
    case "${raw}" in
        *[!A-Za-z0-9._-]*)
            out_die "--prefix allows only letters, digits, dot, underscore, and hyphen. Next: ${APP_NAME} help"
            ;;
    esac
    PROJECT_PREFIX="${raw}"
}

# =============================================================================
# domain_apply_boot_line() — select the Spring Boot 2 or Spring Boot 3 pin set
# =============================================================================
#
# GENERAL PURPOSE:
# Apply one of the two supported payload lines before install/setup/run/about.
# Default (unset, 3, springboot3) keeps Spring Boot 3.3.5 / Java 21 Temurin.
# 2 / springboot2 selects Spring Boot 2.7.18 / Java 8 Amazon Corretto.
# Each line uses its own default project directory unless --project-dir or
# a pre-set PROJECT_DIR already named a path.
# --project-base and --prefix compose that default directory.
# An explicit PORT stays. Otherwise Boot 3 listens on 8080 and Boot 2 on 8081
# so both default roots can run on one machine.
#
# requirement-domain-springboot3.md
# =============================================================================
domain_apply_boot_line() {
    local raw="${1:-${BOOT_LINE:-3}}"
    : "${MVN_PRJ_VERSION:=0.0.1}"
    : "${HOME:=/tmp}"
    : "${PROJECT_DIR_EXPLICIT:=0}"
    : "${PROJECT_BASE:=${HOME}}"
    : "${PROJECT_PREFIX:=}"
    : "${PORT_EXPLICIT:=0}"
    : "${APP_NAME:=springboot3}"

    case "${raw}" in
        2|springboot2|sb2)
            BOOT_LINE="springboot2"
            ;;
        3|springboot3|sb3)
            BOOT_LINE="springboot3"
            ;;
        *)
            out_die "Unknown Spring Boot line '${raw}'. Next: ${APP_NAME} help — use --springboot2 or --springboot3 (or --boot 2|3)."
            ;;
    esac

    if [ "${BOOT_LINE}" = "springboot2" ]; then
        JAVA_ID="8.0.472-amzn"
        JAVA_VERSION="1.8"
        JAVA_DISTRIBUTION="Amazon Corretto"
        JAVA_NAME="Java ${JAVA_VERSION} (Amazon Corretto)"
        SPRINGBOOT_VER="2.7.18"
        PROJECT_NAME="springboot-springboot2"
    else
        JAVA_ID="21.0.10-tem"
        JAVA_VERSION="21"
        JAVA_DISTRIBUTION="Temurin"
        JAVA_NAME="Java ${JAVA_VERSION} (Eclipse Temurin)"
        SPRINGBOOT_VER="3.3.5"
        PROJECT_NAME="springboot-springboot3"
    fi

    ARTIFACT_ID="hello-${BOOT_LINE}"
    JAR_NAME="${ARTIFACT_ID}-${MVN_PRJ_VERSION}.jar"
    case "${PROJECT_BASE}" in
        ''|*$'\n'*|*$'\r'*)
            out_die "--project-base requires a directory path. Next: ${APP_NAME} help"
            ;;
    esac
    if [ -n "${PROJECT_PREFIX}" ]; then
        domain_require_prefix "${PROJECT_PREFIX}"
    fi
    if [ "${PROJECT_DIR_EXPLICIT}" -eq 0 ]; then
        if [ -n "${PROJECT_PREFIX}" ]; then
            PROJECT_DIR="${PROJECT_BASE}/${PROJECT_NAME}-${PROJECT_PREFIX}"
        else
            PROJECT_DIR="${PROJECT_BASE}/${PROJECT_NAME}"
        fi
    fi
    if [ "${PORT_EXPLICIT}" -eq 1 ]; then
        domain_require_listen_port "${PORT}"
    elif [ "${BOOT_LINE}" = "springboot2" ]; then
        PORT="8081"
    else
        PORT="8080"
    fi

    export BOOT_LINE JAVA_ID JAVA_VERSION JAVA_DISTRIBUTION JAVA_NAME
    export SPRINGBOOT_VER PROJECT_NAME ARTIFACT_ID JAR_NAME PROJECT_DIR
    export PROJECT_BASE PROJECT_PREFIX PORT PORT_EXPLICIT
}

# =============================================================================
# domain_align_listen_port() — keep server.port and this invocation together
# =============================================================================
#
# GENERAL PURPOSE:
# An explicit port updates only the server.port key. A preserved properties
# file keeps its port, and this invocation adopts that port for the banner.
# Call this from the project directory after application.properties exists.
#
# requirement-domain-springboot3.md
# =============================================================================
domain_align_listen_port() {
    local props="src/main/resources/application.properties"
    local line n tmp
    : "${PORT_EXPLICIT:=0}"
    : "${PORT:=8080}"
    if [ ! -f "${props}" ]; then
        return 0
    fi
    if [ "${PORT_EXPLICIT}" -eq 1 ]; then
        tmp=$(mktemp "${TMPDIR:-/tmp}/sb-port.XXXXXX") || out_die "Cannot create a temp file to update server.port"
        if grep -q '^server\.port=' "${props}"; then
            sed "s/^server\\.port=.*/server.port=${PORT}/" "${props}" > "${tmp}" || out_die "Cannot update server.port"
        else
            cat "${props}" > "${tmp}" || out_die "Cannot read application.properties"
            printf 'server.port=%s\n' "${PORT}" >> "${tmp}"
        fi
        mv "${tmp}" "${props}" || out_die "Cannot replace application.properties"
        return 0
    fi
    line=$(grep '^server\.port=' "${props}" | head -n 1 | cut -d= -f2 | tr -d ' \t\r')
    if [ -z "${line}" ]; then
        return 0
    fi
    case "${line}" in
        *[!0-9]*) return 0 ;;
    esac
    n=$((10#${line}))
    if [ "${n}" -ge 1 ] && [ "${n}" -le 65535 ]; then
        PORT="${n}"
    fi
}

