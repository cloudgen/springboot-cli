run_springboot_project() {
    # --- Safe Variable Defaults ----
    # Defensive defaults - never assume globals are set
    # PROJECT_DIR is domain law (not util_resolve_storage); match Config default under HOME
    : "${HOME:=/tmp}"
    : "${PROJECT_DIR:=${HOME}/springboot-${APP_NAME}}"
    : "${SPRINGBOOT_VER:=3.3.5}"
    : "${PORT:=8080}"
    : "${JAR_NAME:=hello-${APP_NAME}-0.0.1.jar}"
    : "${JSON:=0}"
    : "${QUIET:=0}"

    out_info "Building project with Maven..."

    mvn clean package -DskipTests || {
        out_warn "Maven build failed."
        out_plain "Debug hint: cd \"${PROJECT_DIR}\" && mvn clean package -DskipTests"
        out_plain "Check pom.xml, Java source, or network issues"
        exit 1
    }

    local jar_path="target/${JAR_NAME}"

    if [ -f "${jar_path}" ]; then
        out_empty_line
        out_double_line
        out_plain "  Spring Boot ${SPRINGBOOT_VER} is starting..."
        out_plain "  → Open: http://localhost:${PORT}/"
        out_plain "  → Ctrl+C to stop"
        out_double_line
        out_empty_line
        out_empty_line

        exec java -jar "${jar_path}" --server.port="${PORT}"
    else
        out_error "Maven reported success but expected JAR file is missing!"
        out_error "   Expected JAR : ${jar_path}"
        out_error "   Project dir  : ${PROJECT_DIR}"
        out_plain "Debug command: ls -la \"${PROJECT_DIR}/target/\""
        exit 1
    fi
}

# =============================================================================
# app_about() - Display diagnostic information about the current environment
# =============================================================================
#
# GENERAL PURPOSE:
# Shows detailed diagnostic information: version, installation status (global + local),
# current shell, TTY/interactive status, user, and helpful next steps.
#
# Fully respects --quiet and --json modes.
# In JSON mode: outputs exactly ONE clean, machine-readable JSON object.
# In quiet mode: prints nothing.
#
# This function provides real value to users (unlike the previous overly simple version)
# and should be kept in sync with the overall CIAO design and README.md.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# Designed to be reusable in other CIAO projects.
# Last reviewed: April 2026
# =============================================================================

# =============================================================================
# util_get_current_shell() - Detect current / parent shell name
# =============================================================================
#
# GENERAL PURPOSE:
# Returns a best-effort shell command name for diagnostics (about).
# Prefer parent shell when the current process is sh/dash/ash/the app itself.
#
# PRINTF EXCEPTION (class B – function return-via-stdout):
# Final printf '%s' "$shell" (and echo fallbacks inside $(…)) are data
# returns for capture by app_about — not product messages. Display uses out_*.
# See requirement-shell-output-requirements.md §2.1.1.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# Nested functions are not portable POSIX; this must stay top-level.
#
# Last reviewed: 2026-07-12
# =============================================================================

app_about() {
    # A kept project file is the listen port unless this invocation passed --port.
    if [ "${PORT_EXPLICIT:-0}" -eq 0 ]; then
        local _props="${PROJECT_DIR}/src/main/resources/application.properties"
        local _line _n
        if [ -f "${_props}" ]; then
            _line=$(grep '^server\.port=' "${_props}" | head -n 1 | cut -d= -f2 | tr -d ' \t\r')
            case "${_line}" in
                ''|*[!0-9]*) ;;
                *)
                    _n=$((10#${_line}))
                    if [ "${_n}" -ge 1 ] && [ "${_n}" -le 65535 ]; then
                        PORT="${_n}"
                    fi
                    ;;
            esac
        fi
    fi

    if [ "${JSON}" -eq 1 ]; then
        # === JSON MODE - Clean machine output ===
        local installed="false"
        inst_is_installed && installed="true"

        local sdkman_status="not found"
        [ -d "${HOME}/.sdkman" ] && sdkman_status="installed"

        local java_version="not found"
        if command -v java >/dev/null 2>&1; then
            java_version=$(java -version 2>&1 | head -n 1 | tr -d '\n\r')
        fi

        local maven_version="not found"
        if command -v mvn >/dev/null 2>&1; then
            maven_version=$(mvn --version | head -n 1 | tr -d '\n\r')
        fi

        local project_exists="false"
        [ -d "${PROJECT_DIR}" ] && project_exists="true"

        local app_running="false"
        if command -v ss >/dev/null 2>&1 && ss -tuln 2>/dev/null | grep -q ":${PORT}"; then
            app_running="true"
        elif command -v netstat >/dev/null 2>&1 && netstat -tuln 2>/dev/null | grep -q ":${PORT}"; then
            app_running="true"
        fi

        # Resolve storage if main has not yet (defensive)
        if [ -z "${EFFECTIVE_STORAGE_DIR:-}" ]; then
            EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
        fi
        if [ -z "${PERSISTENT_STORAGE_DIR:-}" ]; then
            PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
        fi
        STORAGE_DIR=$(util_fallback_cache_dir)
        local _cache_pref _cache_fb2
        _cache_pref=$(util_preferred_cache_dir)
        _cache_fb2=$(util_fallback2_cache_dir)

        # Clean JSON output - no generic message
        out_json "about" "" \
            "app" "${APP_NAME}" \
            "version" "${VERSION}" \
            "boot_line" "${BOOT_LINE:-springboot3}" \
            "springboot_ver" "${SPRINGBOOT_VER:-3.3.5}" \
            "java_id" "${JAVA_ID:-21.0.10-tem}" \
            "installed" "${installed}" \
            "sdkman" "${sdkman_status}" \
            "java" "${java_version}" \
            "maven" "${maven_version}" \
            "project_dir" "${PROJECT_DIR}" \
            "project_base" "${PROJECT_BASE:-${HOME}}" \
            "prefix" "${PROJECT_PREFIX:-}" \
            "project_exists" "${project_exists}" \
            "port" "${PORT}" \
            "app_running" "${app_running}" \
            "effective_storage" "${EFFECTIVE_STORAGE_DIR}" \
            "storage_dir" "${STORAGE_DIR}" \
            "cache_used" "${EFFECTIVE_STORAGE_DIR}" \
            "cache_preferred" "${_cache_pref}" \
            "cache_fallback" "${STORAGE_DIR}" \
            "cache_fallback_2" "${_cache_fb2}" \
            "persistence_storage" "${PERSISTENT_STORAGE_DIR}" \
            "user" "${USERNAME}" \
            "shell" "$(ps -p $$ -o comm= 2>/dev/null | tr -d '()')"

        return 0
    fi

    # === HUMAN-READABLE MODE ===
    [ "${QUIET}" -eq 1 ] && return 0

    out_plain "$(app_menu_text about_h)"
    out_plain "${APP_NAME} ${VERSION}"
    out_plain "Boot line  : ${BOOT_LINE:-springboot3} (Spring Boot ${SPRINGBOOT_VER:-3.3.5}, ${JAVA_NAME:-Java 21 (Eclipse Temurin)})"
    out_empty_line

    if inst_is_installed; then
        out_success "${APP_NAME} is installed at ${INSTALL_PATH}"
    else
        out_warn "${APP_NAME} is NOT installed."
    fi

    out_empty_line

    # SDKMAN
    if [ -d "${HOME}/.sdkman" ]; then
        out_success "SDKMAN     : installed"
    else
        out_warn "SDKMAN     : not found"
    fi

    # Java
    if command -v java >/dev/null 2>&1; then
        out_plain "Java       : $(java -version 2>&1 | head -n 1)"
    else
        out_warn "Java       : not found"
    fi

    # Maven
    if command -v mvn >/dev/null 2>&1; then
        out_plain "Maven      : $(mvn --version | head -n 1)"
    else
        out_warn "Maven      : not found"
    fi

    # Project
    if [ -d "${PROJECT_DIR}" ]; then
        out_success "Project    : ${PROJECT_DIR} (exists)"
    else
        out_warn "Project    : ${PROJECT_DIR} (does not exist)"
    fi
    out_plain "Base path  : ${PROJECT_BASE:-${HOME}}"
    if [ -n "${PROJECT_PREFIX:-}" ]; then
        out_plain "Prefix     : ${PROJECT_PREFIX}"
    else
        out_plain "Prefix     : (none)"
    fi

    # Cache folder and persistence (not the project dir, not the language leaf)
    if [ -z "${EFFECTIVE_STORAGE_DIR:-}" ]; then
        EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    fi
    if [ -z "${PERSISTENT_STORAGE_DIR:-}" ]; then
        PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
    fi
    STORAGE_DIR=$(util_fallback_cache_dir)
    local _cache_pref _cache_fb2 _cache_label
    _cache_pref=$(util_preferred_cache_dir)
    _cache_fb2=$(util_fallback2_cache_dir)
    _cache_label=$(app_menu_text cache_used)
    out_info "${_cache_label} ${EFFECTIVE_STORAGE_DIR}"
    out_info "Cache folder (preferred): ${_cache_pref}"
    out_info "Cache folder (1st fallback): ${STORAGE_DIR}"
    if [ -n "${_cache_fb2}" ]; then
        out_info "Cache folder (2nd fallback): ${_cache_fb2}"
    fi
    out_info "Persistence storage: ${PERSISTENT_STORAGE_DIR}"

    # App running status
    local running_status="no"
    if command -v ss >/dev/null 2>&1 && ss -tuln 2>/dev/null | grep -q ":${PORT}"; then
        running_status="yes"
    elif command -v netstat >/dev/null 2>&1 && netstat -tuln 2>/dev/null | grep -q ":${PORT}"; then
        running_status="yes"
    fi
    out_plain "App on port ${PORT} : ${running_status}"

    out_empty_line
    out_plain "Use '${APP_NAME} about --json' for machine-readable output."
    out_plain "Current project directory can be changed with --project-dir <path>"
}

app_version() {
    : "${APP_NAME:=springboot3}"
    : "${VERSION:=1.0.0}"
    : "${JSON:=0}"
    if [ "${JSON}" -eq 1 ]; then
        # Same machine contract as historical app_main inline path
        out_json "version" "" "app" "${APP_NAME}" "version" "${VERSION}"
