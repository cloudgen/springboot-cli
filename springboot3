setup_java() {
# --- Safe Variable Defaults ----
    # Defensive defaults - never assume globals are set
    : "${JAVA_ID:=21.0.10-tem}"
    : "${JAVA_NAME:=Java 21 (Eclipse Temurin)}"
    : "${HOME:=/root}"

