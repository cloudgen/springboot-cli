app_menu_unknown_line() {
    local _tok="${1-}"
    local _line
    _line=$(app_menu_text unknown)
    printf '%s' "${_line%%TOKEN*}${_tok}${_line#*TOKEN}"
}

app_lang_code_ok() {
    case "${1-}" in
        en|zh-Hans|zh-Hant|es|ar|fr|pt|ru|de|ja|ko|nl|el) return 0 ;;
        *) return 1 ;;
    esac
}

app_lang_load() {
    if [ "${APP_LANG_LOADED:-0}" -eq 1 ]; then
        return 0
    fi
    APP_LANG_LOADED=1
    APP_LANG="en"
    if app_lang_code_ok "${SPRINGBOOT3_LANG:-}"; then
        APP_LANG="${SPRINGBOOT3_LANG}"
        return 0
    fi
    local _leaf="${HOME}/.local/${APP_NAME}/language"
    local _line=""
    if [ -f "${_leaf}" ]; then
        _line=$(head -n 1 "${_leaf}" 2>/dev/null | tr -d '\r' || true)
        if app_lang_code_ok "${_line}"; then
            APP_LANG="${_line}"
        fi
    fi
    return 0
}

app_lang_save() {
    local _code="${1-}"
    app_lang_code_ok "${_code}" || return 1
    local _dir="${PERSISTENT_STORAGE_DIR:-${HOME}/.local/${APP_NAME}}"
    if [ ! -d "${_dir}" ]; then
        mkdir -m 0700 -p "${_dir}" 2>/dev/null || return 1
    fi
    local _tmp
    _tmp=$(mktemp "${_dir}/.language.XXXXXX" 2>/dev/null) || return 1
    if ! printf '%s\n' "${_code}" > "${_tmp}"; then
        rm -f "${_tmp}"
        return 1
    fi
    chmod 0600 "${_tmp}" 2>/dev/null || true
    if ! mv -f "${_tmp}" "${_dir}/language"; then
        rm -f "${_tmp}"
        return 1
    fi
    chmod 0600 "${_dir}/language" 2>/dev/null || true
    APP_LANG="${_code}"
    return 0
}


# =============================================================================
# out_menu_choice() - One numbered menu row
# =============================================================================
# requirement-shell-cli-default-interaction.md
# On a TTY the short name is SGR 1 and the long description is SGR 3;37.
# JSON and a non-TTY print the asterisk form with no CSI.
# This printer MUST NOT call read.
# =============================================================================
out_menu_choice() {
    local _num="${1-}"
    local _short="${2-}"
    local _long="${3-}"
    if [ "${JSON:-0}" -eq 1 ] || [ "${TTY:-0}" -ne 1 ]; then
        printf '%s\n' "${_num}. **${_short}**: *${_long}*"
        return 0
    fi
    printf '%s. \033[1m%s\033[0m: \033[3;37m%s\033[0m\n' "${_num}" "${_short}" "${_long}"
}

_menu_say() {
    if [ "${JSON:-0}" -eq 1 ]; then
        printf '%s\n' "${1-}"
    else
        out_info "${1-}"
    fi
}

_menu_plain() {
    if [ "${JSON:-0}" -eq 1 ]; then
        printf '%s\n' "${1-}"
    else
        out_plain "${1-}"
    fi
}

_menu_header() {
    local _tok="**${APP_NAME}**(*${VERSION}*)"
    if [ "${JSON:-0}" -eq 1 ]; then
        printf '%s\n' "${_tok}"
    else
        out_info "${_tok}"
    fi
}

_menu_prompt() {
    local _p
    _p=$(app_menu_text choose)
    case "${_p}" in
        *' ') ;;
        *) _p="${_p} " ;;
    esac
    _menu_plain "${_p}"
}

_menu_bad() {
    local _msg
    _msg=$(app_menu_unknown_line "${1-}")
    if [ "${JSON:-0}" -eq 1 ]; then
        printf '%s\n' "${_msg}"
    else
        out_error "${_msg}"
    fi
}

_menu_trim() {
    local _s="${1-}"
    _s="${_s//$'\r'/}"
    _s="${_s#"${_s%%[![:space:]]*}"}"
    _s="${_s%"${_s##*[![:space:]]}"}"
    printf '%s' "${_s}"
}

_menu_lang_long() {
    local _code="${1-}"
    local _saved="${APP_LANG:-en}"
    local _v
    APP_LANG="en"
    _v=$(app_menu_text "Llang.${_code}")
    APP_LANG="${_saved}"
    printf '%s' "${_v}"
}

# Payload pipeline shared by the run verb and menu rows 1, 2, 31, and 32.
# --no-run returns. A successful jar start replaces this process.
payload_ensure_and_run() {
    if ! check_alpine_requirements; then
        out_die "Alpine/bash prerequisites check failed"
    fi
    if ! setup_sdkman; then
        out_die "Payload step failed: SDKMAN setup"
    fi
    if ! setup_java; then
        out_die "Payload step failed: Java setup"
    fi
    if ! setup_maven; then
        out_die "Payload step failed: Maven setup"
    fi
    if ! setup_springboot_project; then
        out_die "Payload step failed: Spring Boot project setup"
    fi

    if [ "${NO_RUN:-0}" -eq 1 ]; then
        if [ "${JSON:-0}" -eq 1 ]; then
            out_json "out_success" "" \
                "message" "Environment and project setup completed" \
                "project_dir" "${PROJECT_DIR}" \
                "project_base" "${PROJECT_BASE:-${HOME}}" \
                "prefix" "${PROJECT_PREFIX:-}" \
                "port" "${PORT}" \
                "no_run" "true" \
                "boot_line" "${BOOT_LINE:-springboot3}" \
                "springboot_ver" "${SPRINGBOOT_VER:-3.3.5}" \
                "layer" "payload"
        else
            out_success "Environment and project setup completed (--no-run)."
            out_success "Project location: ${PROJECT_DIR}"
            out_info "Listen port: ${PORT}"
        fi
        return 0
    fi

    out_info "Starting Spring Boot application (payload run)..."
    run_springboot_project
}

_menu_run_line() {
    local _which="${1-3}"
    local _no="${2-0}"
    if [ "${_which}" = "2" ]; then
        BOOT_LINE="springboot2"
    else
        BOOT_LINE="springboot3"
    fi
    BOOT_LINE_SET=1
    NO_RUN="${_no}"
    domain_apply_boot_line "${BOOT_LINE}"
    payload_ensure_and_run
    return 0
}

